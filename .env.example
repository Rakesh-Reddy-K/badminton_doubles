# Environment Configuration
# Copy this file to .env and update the values

# ─────────────────────────────────────────────────
# Local Docker Compose (uses local Postgres)
# ─────────────────────────────────────────────────
POSTGRES_DB=badminton
POSTGRES_USER=badminton
POSTGRES_PASSWORD=badminton_secret

# Backend
SPRING_PROFILES_ACTIVE=docker
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/badminton
SPRING_DATASOURCE_USERNAME=badminton
SPRING_DATASOURCE_PASSWORD=badminton_secret

# Frontend
VITE_API_BASE_URL=http://localhost:8080

# ─────────────────────────────────────────────────
# Render / Supabase (set these in Render Dashboard)
# ─────────────────────────────────────────────────
# SPRING_PROFILES_ACTIVE=render
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# SPRING_DATASOURCE_USERNAME=postgres.ldubpjthhruvbbktmwkp
# SPRING_DATASOURCE_PASSWORD=<your-supabase-db-password>
# CORS_ALLOWED_ORIGINS=https://badminton-frontend.onrender.com
# JAVA_OPTS=-Xms256m -Xmx512m

